{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=PermixaApp;User Id=sa;Password=Your_strong_DevOnly_Password123;TrustServerCertificate=True;Encrypt=False"
    //#if (redis)
    ,"Redis": "localhost:6379"
    //#endif
  },
  "Permixa": {
    "Bootstrap": {
      "Enabled": true
    },
    "Authentication": {
      //#if (resend)
      "RequireConfirmedEmail": true
      //#else
      "RequireConfirmedEmail": false
      //#endif
    },
    "AppSeed": {
      "Enabled": true
    }
    //#if (resend)
    ,"Email": {
      "FromEmail": "noreply@example.com",
      "FromName": "PermixaApp",
      "ApplicationName": "PermixaApp",
      "EmailConfirmationUrlTemplate": "https://localhost/verify-email?challengeId={challengeId}&token={token}",
      "PasswordResetUrlTemplate": "https://localhost/reset-password?challengeId={challengeId}&token={token}"
    },
    "Resend": {
      "ApiKey": ""
    }
    //#endif
  }
}
