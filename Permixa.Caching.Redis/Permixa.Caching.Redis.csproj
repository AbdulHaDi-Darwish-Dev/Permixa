<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Permixa.Caching.Redis</PackageId>
    <Title>Permixa IAM - Redis Authorization Cache</Title>
    <Description>Optional Redis authorization-cache provider for Permixa IAM. Install only when using AddPermixaRedisAuthorizationCache; core Permixa packages do not require StackExchange.Redis.</Description>
    <PackageTags>permixa;redis;caching;authorization-cache;stackexchange-redis;aspnetcore;dotnet;iam</PackageTags>
    <RootNamespace>Permixa.Caching.Redis</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Permixa.Application\Permixa.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Permixa.Caching.Redis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
